# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Optional build-time key for verified nearby places on project pages.
# Restrict this key to Geocoding API and Places API. Do not expose it through Vite client variables.
GOOGLE_MAPS_API_KEY="MY_RESTRICTED_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local-only service credential used by scripts/translation-cloud.ts.
# Keep the JSON file out of Git and set this only in your local shell or CI secret store.
# GOOGLE_APPLICATION_CREDENTIALS=".secrets/gcp/translation-service-account.json"

# Server-side localization model routing. Keep these unset to use the safe defaults.
# Gemini 3.5 Flash is the current stable default for draft, review and source editing.
# Override these independently when a quality/cost experiment requires another model.
# GEMINI_LOCALIZATION_DRAFT_MODEL="gemini-3.5-flash"
# GEMINI_LOCALIZATION_REVIEW_MODEL="gemini-3.5-flash"
# GEMINI_LOCALIZATION_SOURCE_MODEL="gemini-3.5-flash"
