{
  "schemaVersion": 1,
  "contracts": {
    "content.title": { "purpose": "Project or page heading", "maxWords": 12, "requiredFacts": [], "optionalFacts": ["projectName", "projectType"], "forbiddenFacts": [], "mustNotRepeat": [], "allowInterpretation": false },
    "content.eyebrow": { "purpose": "Short project label or context line", "maxWords": 8, "requiredFacts": [], "optionalFacts": ["location", "status"], "forbiddenFacts": [], "mustNotRepeat": [], "allowInterpretation": false },
    "content.summary": { "purpose": "One-sentence hero overview; establish location and project type before secondary detail", "maxWords": 64, "requiredFacts": ["location", "projectType"], "optionalFacts": ["storeys", "residentialUnits", "principalUses"], "forbiddenFacts": ["unitsPerTypicalFloor", "parkingTechnicalBreakdown"], "mustNotRepeat": ["content.description", "content.faq"], "allowInterpretation": false },
    "content.description": { "purpose": "One or two concise paragraphs explaining scope and supported technical detail", "maxParagraphs": 2, "maxWords": 180, "requiredFacts": [], "optionalFacts": ["constructionScope", "principalUses", "circulation", "materials"], "forbiddenFacts": ["unsupportedEngineeringClaim", "unsupportedSustainabilityClaim"], "mustNotRepeat": ["content.summary"], "allowInterpretation": false },
    "content.authority": { "purpose": "Neutral delivery or scope statement; never imply unsupported contractor responsibility", "maxWords": 45, "requiredFacts": [], "optionalFacts": ["status", "deliveryYear", "contractScope"], "forbiddenFacts": ["architecturalSignificance", "unsupportedContractorScope"], "mustNotRepeat": ["content.summary", "content.description"], "allowInterpretation": false, "omitWhenUnsupported": true },
    "content.meta": { "purpose": "Compact structured project metadata", "maxWords": 80, "requiredFacts": [], "optionalFacts": ["location", "status", "projectType"], "forbiddenFacts": [], "mustNotRepeat": [], "allowInterpretation": false },
    "content.details": { "purpose": "Structured factual values; preserve labels, units, codes and numerical detail", "maxWords": 240, "requiredFacts": [], "optionalFacts": ["storeys", "housingUnits", "parkingLevels", "programmeCodes"], "forbiddenFacts": [], "mustNotRepeat": [], "allowInterpretation": false },
    "content.facilityGroups": { "purpose": "Grouped facilities or scope lists; keep lists parallel and factual", "maxWords": 240, "requiredFacts": [], "optionalFacts": ["facilities", "constructionScope"], "forbiddenFacts": [], "mustNotRepeat": [], "allowInterpretation": false },
    "content.nearby": { "purpose": "Nearby places and distances from verified source data only", "maxWords": 180, "requiredFacts": [], "optionalFacts": ["nearbyPlaces", "distances"], "forbiddenFacts": ["lifestyleBenefit"], "mustNotRepeat": [], "allowInterpretation": false },
    "content.faq": { "purpose": "Useful questions and distinct answers; never copy the hero", "maxWords": 360, "requiredFacts": [], "optionalFacts": ["scope", "distribution", "status"], "forbiddenFacts": ["unsupportedMarketingClaim"], "mustNotRepeat": ["content.summary"], "allowInterpretation": false },
    "seo.title": { "purpose": "Search title identifying project and location without stuffing", "maxWords": 12, "requiredFacts": [], "optionalFacts": ["projectName", "location", "projectType"], "forbiddenFacts": ["keywordStacking"], "mustNotRepeat": [], "allowInterpretation": false },
    "seo.description": { "purpose": "Natural search description without unsupported superlatives", "maxWords": 32, "requiredFacts": [], "optionalFacts": ["projectName", "location", "projectType", "scope"], "forbiddenFacts": ["architecturalExcellence", "premium", "landmark"], "mustNotRepeat": ["content.summary"], "allowInterpretation": false },
    "seo.socialTitle": { "purpose": "Short social title with one clear subject", "maxWords": 12, "requiredFacts": [], "optionalFacts": ["projectName", "location"], "forbiddenFacts": ["superlative"], "mustNotRepeat": [], "allowInterpretation": false },
    "seo.socialDescription": { "purpose": "Social description with a single factual angle", "maxWords": 32, "requiredFacts": [], "optionalFacts": ["projectName", "scope", "location"], "forbiddenFacts": ["superlative", "lifestyleBenefit"], "mustNotRepeat": [], "allowInterpretation": false },
    "content.images.*.alt": { "purpose": "Descriptive accessibility text for visible subject matter", "maxWords": 18, "requiredFacts": [], "optionalFacts": ["visibleBuildingType", "visibleLocation"], "forbiddenFacts": ["architecturalSignificance", "invisibleConstructionProcess"], "mustNotRepeat": ["content.images.*.caption"], "allowInterpretation": false },
    "content.images.*.caption": { "purpose": "Short caption adding context without duplicating alt text", "maxWords": 28, "requiredFacts": [], "optionalFacts": ["projectPhase", "visibleScope"], "forbiddenFacts": ["lifestyleBenefit", "unsupportedClaim"], "mustNotRepeat": ["content.images.*.alt"], "allowInterpretation": false }
  }
}
