  "seo": {
    "title": "\u0627\u0644\u0628\u0646\u0627\u0621 \u0627\u0644\u062a\u062c\u0627\u0631\u064a \u0641\u064a \u0627\u0644\u062c\u0632\u0627\u0626\u0631 | Igloo Construction",
    "description": "\u062a\u0646\u0641\u0630 Igloo Construction \u0627\u0644\u0645\u0631\u0627\u0643\u0632 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0648\u0641\u0636\u0627\u0621\u0627\u062a \u0627\u0644\u0628\u064a\u0639 \u0648\u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0645\u062e\u062a\u0644\u0637\u0629 \u0641\u064a \u0627\u0644\u062c\u0632\u0627\u0626\u0631.",
    "socialTitle": "\u0627\u0644\u0628\u0646\u0627\u0621 \u0627\u0644\u062a\u062c\u0627\u0631\u064a \u0641\u064a \u0627\u0644\u062c\u0632\u0627\u0626\u0631 | Igloo Construction",
    "socialDescription": "\u062a\u0646\u0641\u064a\u0630 \u062a\u062c\u0627\u0631\u064a \u0645\u0631\u062a\u0628\u0637 \u0628\u0645\u0634\u0627\u0631\u064a\u0639 \u0633\u0643\u0646\u064a\u0629 \u0648\u0639\u0645\u0631\u0627\u0646\u064a\u0629 \u062d\u0642\u064a\u0642\u064a\u0629."
  },
  "content": {
    "eyebrow": "\u0627\u0644\u0628\u0646\u0627\u0621 \u0627\u0644\u062a\u062c\u0627\u0631\u064a",
    "heading": "\u0641\u0636\u0627\u0621\u0627\u062a \u062a\u062c\u0627\u0631\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u0623\u0648\u0633\u0639.",
    "lead": "\u062a\u0646\u0641\u0630 Igloo Construction \u0627\u0644\u0645\u0631\u0627\u0643\u0632 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0648\u0627\u0644\u062d\u0632\u0645 \u0627\u0644\u0645\u062e\u062a\u0644\u0637\u0629 \u0645\u0639 \u0627\u0644\u0627\u0647\u062a\u0645\u0627\u0645 \u0628\u0627\u0644\u0647\u064a\u0643\u0644 \u0648\u0627\u0644\u062d\u0631\u0643\u0629 \u0648\u0627\u0644\u062a\u0634\u0637\u064a\u0628.",
    "paragraphs": [
      "\u062a\u0638\u0647\u0631 \u0645\u0631\u0627\u0643\u0632 Rahmania \u0648\u0645\u062c\u0645\u0639 Said Hamdine \u0627\u0644\u0645\u062e\u062a\u0644\u0637 \u0643\u064a\u0641 \u062a\u0646\u062f\u0645\u062c \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0641\u064a \u062a\u0637\u0648\u064a\u0631\u0627\u062a \u0633\u0643\u0646\u064a\u0629 \u0648\u0639\u0645\u0631\u0627\u0646\u064a\u0629 \u0623\u0648\u0633\u0639.",
      "\u0646\u0646\u0633\u0642 \u0627\u0644\u0648\u0627\u062c\u0647\u0627\u062a \u0628\u064a\u0646 \u0627\u0644\u0645\u062d\u0644\u0627\u062a \u0648\u0627\u0644\u0633\u0643\u0646 \u0648\u0627\u0644\u0648\u0635\u0648\u0644 \u0648\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639."
    ],
    "scope": ["\u0645\u0631\u0627\u0643\u0632 \u062a\u062c\u0627\u0631\u064a\u0629 \u0648\u0645\u062d\u0644\u0627\u062a \u0627\u0644\u0628\u064a\u0639", "\u062d\u0632\u0645 \u0628\u0646\u0627\u0621 \u0645\u062e\u062a\u0644\u0637", "\u062a\u0634\u0637\u064a\u0628 \u0648\u062d\u0631\u0643\u0629 \u0648\u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0645\u0648\u0642\u0639"],
    "proofSlugs": ["rahmania", "said-hamdine-mixed-real-estate"],
