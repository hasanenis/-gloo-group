  "content": {
    "eyebrow": "\u0623\u0634\u063a\u0627\u0644 \u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u062a\u062d\u062a\u064a\u0629",
    "heading": "\u0627\u0644\u0634\u0628\u0643\u0627\u062a \u0648\u0627\u0644\u0648\u0635\u0648\u0644 \u062d\u0648\u0644 \u0627\u0644\u0645\u0628\u0646\u0649 \u0645\u0647\u0645\u0629.",
    "lead": "\u062a\u0646\u0633\u0642 Igloo Construction \u0627\u0644\u0637\u0631\u0642 \u0648\u0634\u0628\u0643\u0627\u062a \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648\u0623\u0639\u0645\u0627\u0644 \u0627\u0644\u0645\u0648\u0642\u0639 \u0644\u062c\u0639\u0644 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u062c\u0627\u0647\u0632\u0629 \u0644\u0644\u0627\u0633\u062a\u0639\u0645\u0627\u0644.",
    "paragraphs": [
      "\u062a\u0634\u0645\u0644 \u062e\u0628\u0631\u062a\u0646\u0627 \u0623\u0634\u063a\u0627\u0644 \u0627\u0644\u0637\u0631\u0642 \u0648\u0627\u0644\u0634\u0628\u0643\u0627\u062a \u0644\u0641\u064a\u0644\u0627\u062a Staoueli \u0648\u0628\u0631\u0646\u0627\u0645\u062c \u0633\u0643\u0646 Douaouda \u0648\u0645\u0648\u0627\u0642\u0639 \u0623\u062e\u0631\u0649 \u0641\u064a \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062c\u0632\u0627\u0626\u0631 \u0627\u0644\u0643\u0628\u0631\u0649.",
      "\u064a\u062a\u0645 \u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u0643\u062c\u0632\u0621 \u0645\u0646 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0645\u0639 \u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0645\u0628\u0627\u0646\u064a \u0648\u0627\u0644\u0641\u0636\u0627\u0621\u0627\u062a \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629."
    ],
    "scope": ["\u0627\u0644\u0637\u0631\u0642 \u0648\u0627\u0644\u0648\u0635\u0648\u0644", "\u0634\u0628\u0643\u0627\u062a \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648\u062d\u0632\u0645 VRD", "\u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0645\u0648\u0642\u0639 \u0648\u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u062a\u0637\u0648\u064a\u0631"],
