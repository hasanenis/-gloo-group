  "content": {
    "eyebrow": "\u0627\u0644\u0628\u0646\u0627\u0621 \u0627\u0644\u0633\u0643\u0646\u064a",
    "heading": "\u0645\u0633\u0627\u0643\u0646 \u0648\u0641\u064a\u0644\u0627\u062a \u0628\u062a\u0646\u0641\u064a\u0630 \u0645\u0646\u0638\u0645.",
    "lead": "\u062a\u0639\u0645\u0644 Igloo Construction \u0641\u064a \u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0633\u0643\u0646 \u0648\u0627\u0644\u0641\u064a\u0644\u0627\u062a \u0645\u0639 \u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0647\u064a\u0627\u0643\u0644 \u0648\u0627\u0644\u0623\u0634\u063a\u0627\u0644 \u0627\u0644\u062b\u0627\u0646\u0648\u064a\u0629 \u0648\u0627\u0644\u0634\u0628\u0643\u0627\u062a.",
    "paragraphs": [
      "\u062a\u0634\u0645\u0644 \u062e\u0628\u0631\u062a\u0646\u0627 \u0628\u0631\u0646\u0627\u0645\u062c 300/500 \u0641\u064a Douaouda \u0648\u0627\u0644\u0633\u0643\u0646 \u0627\u0644\u0639\u0645\u0648\u0645\u064a \u0641\u064a Sidi Abdallah \u0648\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0641\u064a\u0644\u0627\u062a \u0641\u064a Staoueli.",
      "\u064a\u062a\u0645 \u062a\u0646\u0627\u0648\u0644 \u0643\u0644 \u0645\u0634\u0631\u0648\u0639 \u0643\u0645\u0648\u0642\u0639 \u0645\u062a\u0643\u0627\u0645\u0644 \u064a\u0634\u0645\u0644 \u0627\u0644\u0645\u0628\u0646\u0649 \u0648\u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629."
    ],
    "scope": ["\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0633\u0643\u0646 \u0648\u0627\u0644\u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0627\u0644\u0645\u062e\u062a\u0644\u0637", "\u0628\u0646\u0627\u0621 \u0627\u0644\u0641\u064a\u0644\u0627\u062a \u0648\u0627\u0644\u0623\u0634\u063a\u0627\u0644 \u0627\u0644\u062b\u0627\u0646\u0648\u064a\u0629", "\u0627\u0644\u0648\u0635\u0648\u0644 \u0648\u0627\u0644\u0634\u0628\u0643\u0627\u062a \u0648\u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0645\u0648\u0642\u0639"],
