    "socialTitle": "\u0627\u0644\u0628\u0646\u0627\u0621 \u0627\u0644\u0633\u0643\u0646\u064a \u0641\u064a \u0627\u0644\u062c\u0632\u0627\u0626\u0631 | Igloo Construction",
    "socialDescription": "\u062e\u0628\u0631\u0629 \u0641\u064a \u0627\u0644\u0633\u0643\u0646 \u0648\u0627\u0644\u0641\u064a\u0644\u0627\u062a \u0648\u0627\u0644\u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0627\u0644\u0645\u062e\u062a\u0644\u0637 \u0645\u0646 \u0645\u0634\u0627\u0631\u064a\u0639 \u0645\u0646\u062c\u0632\u0629."
