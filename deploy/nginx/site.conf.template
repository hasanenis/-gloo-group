server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}} {{WWW_DOMAIN}};

    root /var/www/{{SITE_SLUG}}/current/dist;
    index index.html;

    access_log /var/log/nginx/{{SITE_SLUG}}.access.log;
    error_log /var/log/nginx/{{SITE_SLUG}}.error.log;

    # React Router — tüm bilinmeyen path'lar index.html'e.
    # Not: $uri/ kasıtlı olarak yok — public/projects/<slug>/ gibi statik
    # varlık klasörleri React route'larıyla (ör. /projects/<slug>) aynı ada
    # sahip; $uri/ denemesi o klasörü bulup index.html'siz 403 dönüyordu.
    location / {
        try_files $uri /index.html;
    }

    # Statik varlıklar — uzun süreli cache, immutable
    location ~* \.(js|css|woff2?|ttf|otf|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Görseller ve video — 1 yıl cache ama immutable değil (güncellenebilir)
    location ~* \.(png|jpe?g|webp|gif|avif|mp4|webm)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000";
    }

    # 404 yanıtları cache'lenmez — Chrome 404'leri bellekte tutmasın
    error_page 404 /index.html;
    add_header Cache-Control "no-store" always;

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }
}
