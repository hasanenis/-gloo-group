server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}} {{WWW_DOMAIN}};

    if ($host = {{WWW_DOMAIN}}) {
        return 308 https://{{DOMAIN}}$request_uri;
    }

    root /var/www/{{SITE_SLUG}}/current/dist;
    index index.html;

    access_log /var/log/nginx/{{SITE_SLUG}}.access.log;
    error_log /var/log/nginx/{{SITE_SLUG}}.error.log;

    # Baseline browser hardening. The policy deliberately allows HTTPS media,
    # fonts and map resources used by the marketing site while blocking plugin
    # content and cross-origin framing.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; font-src 'self' https: data:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' https: wss:; worker-src 'self' blob:;" always;

    # Locale-prefixed prerendered pages are served directly. Unknown paths
    # retain an SPA fallback for client-side navigation.
    location = / { return 308 /en/; }
    location = /about { return 308 /en/about; }
    location = /contact { return 308 /en/contact; }
    location = /projects { return 308 /en/projects; }
    location = /services { return 308 /en/services; }
    location ~ ^/projects/(.+)$ { return 308 /en/projects/$1; }
    location ~ ^/services/(.+)$ { return 308 /en/services/$1; }

    location / {
        try_files $uri $uri/index.html /index.html;
    }

    location = /robots.txt {
        default_type text/plain;
        expires 1h;
    }

    location = /sitemap.xml {
        default_type application/xml;
        expires 1h;
    }

    location = /llms.txt {
        default_type text/markdown;
        expires 1h;
    }

    # Static assets - long-lived immutable cache.
    location ~* \.(js|css|woff2?|ttf|otf|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; font-src 'self' https: data:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' https: wss:; worker-src 'self' blob:;" always;
    }

    # Images and video - long-lived cache without immutable semantics.
    location ~* \.(png|jpe?g|webp|gif|avif|mp4|webm)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; font-src 'self' https: data:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' https: wss:; worker-src 'self' blob:;" always;
    }

    error_page 404 /index.html;
    add_header Cache-Control "no-store" always;

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }
}
